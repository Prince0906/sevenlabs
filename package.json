{
  "name": "sevenlabs",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "copy:vad": "mkdir -p public/vad && cp -R node_modules/@ricky0123/vad-web/dist/. public/vad/ && cp -R node_modules/onnxruntime-web/dist/*.mjs public/vad/ && cp -R node_modules/onnxruntime-web/dist/*.wasm public/vad/",
    "postinstall": "prisma generate && npm run copy:vad",
    "db:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=junit --outputFile=test-reports/junit.xml",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run verify:test && npm run verify:build",
    "verify:test": "cross-env SKIP_ENV_VALIDATION=true DATABASE_URL=postgresql://user:pass@localhost:5432/db vitest run --coverage",
    "verify:build": "cross-env SKIP_ENV_VALIDATION=true DATABASE_URL=postgresql://user:pass@localhost:5432/db next build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.6.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@ricky0123/vad-web": "^0.0.30",
    "@sevenlabs/panel-core": "*",
    "@sevenlabs/shared-types": "*",
    "@t3-oss/env-nextjs": "^0.13.11",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "prisma": "^7.9.0",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
