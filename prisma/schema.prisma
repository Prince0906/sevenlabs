// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Auth.js (NextAuth v5) — Prisma adapter required models
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  targetCompanies String[]    @default(["amazon"])
  interviewDate   DateTime?
  targetLevel     SignalLevel @default(NEW_GRAD)

  accounts Account[]
  sessions Session[]

  practiceSessions PracticeSession[]

  mockSessions      MockSession[]
  confidenceMetrics ConfidenceMetric[]
  drillAssignments  DrillAssignment[]
  outcomes          Outcome[]
  resumeProfile     ResumeProfile?
  providerKeys      ProviderKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// Speaking Coach
// ============================================================

enum PracticeSessionStatus {
  ACTIVE
  COMPLETED
}

enum PracticeTurnRole {
  USER
  COACH
}

model PracticeSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mode   String                @default("delivery")
  status PracticeSessionStatus @default(ACTIVE)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  turns PracticeTurn[]

  @@index([userId])
  @@index([userId, status])
}

model PracticeTurn {
  id        String          @id @default(cuid())
  sessionId String
  session   PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role             PracticeTurnRole
  clientTurnId     String?
  transcript       String?
  metricsJson      Json?
  rubricScoresJson Json?
  audioKey         String?
  coachText        String?

  createdAt DateTime @default(now())

  @@unique([sessionId, clientTurnId])
  @@index([sessionId])
}

// ============================================================
// Confidence Engine (real-time adversarial panel) — additive (P0)
// Everything above is untouched.
// MockTurn.role reuses PracticeTurnRole; role=COACH means "interviewer seat".
// ============================================================

enum SignalLevel {
  NEW_GRAD
  SDE_II
  SENIOR
}

enum LlmProvider {
  OPENAI
  ANTHROPIC
  GEMINI
}

enum InterviewType {
  BEHAVIORAL
  SYSTEM_DESIGN
  CODING_VERBAL
  HIRING_MANAGER
  BAR_RAISER_PANEL
}

enum ScenarioDifficulty {
  WARMUP
  CALIBRATED
  ADVERSARIAL
}

enum MockStatus {
  PENDING
  LIVE
  DEBRIEF
  COMPLETED
  ABANDONED
  FAILED
  INTERRUPTED
}

enum ScoreDimension {
  LP
  STAR_STRUCTURE
  TECHNICAL_DEPTH
  COMMUNICATION
  DELIVERY
}

enum DrillStatus {
  ASSIGNED
  COMPLETED
  SKIPPED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// Real-world result of the interview this mock prepared for. The single label a
// foundation model cannot manufacture — captured against our prior prediction so
// the (prediction → outcome) pair is the calibration corpus. A1.
enum InterviewOutcome {
  ADVANCED // moved to the next round
  REJECTED // did not advance
  GHOSTED // never heard back
  OFFER // received an offer
  PENDING // outcome not known yet (default while waiting)
}

model Scenario {
  id          String             @id @default(cuid())
  company     String
  type        InterviewType
  difficulty  ScenarioDifficulty
  targetLevel SignalLevel
  title       String
  promptText  String             @db.Text
  lpFocus     String[]
  estMinutes  Int                @default(20)
  isActive    Boolean            @default(true)

  panelSeats   PanelSeat[]
  mockSessions MockSession[]
  createdAt    DateTime      @default(now())

  @@index([company, type, targetLevel, difficulty])
  @@index([isActive])
}

model PanelSeat {
  id           String   @id @default(cuid())
  scenarioId   String
  scenario     Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  seatOrder    Int
  personaName  String
  ownedLPs     String[]
  isBarRaiser  Boolean  @default(false)
  voice        String
  systemPrompt String   @db.Text

  @@unique([scenarioId, seatOrder])
  @@index([scenarioId])
}

model MockSession {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioId       String
  scenario         Scenario     @relation(fields: [scenarioId], references: [id])
  clientRequestId  String?
  apiKeyId         String?
  apiKey           ProviderKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  keySource        KeySource    @default(ALOUD)
  provider         LlmProvider  @default(OPENAI)
  modelUsed        String
  status           MockStatus   @default(PENDING)
  targetLevel      SignalLevel
  startedAt        DateTime?
  endedAt          DateTime?
  durationSec      Int?
  spendCents       Int          @default(0)
  // Durable seat cursor — written on each handoff so a mid-panel refresh
  // rehydrates to the correct interviewer instead of seat 0 (D5).
  activeSeatIndex  Int          @default(0)
  // A turn was dropped after exhausting client retries — the report is partial,
  // not silently scored as complete (D6).
  degradedDelivery Boolean      @default(false)
  transcriptKey    String?
  audioOptIn       Boolean      @default(false)
  audioKey         String?
  overallSignal    SignalLevel?
  confidence       Int?
  passed           Boolean?
  reportJson       Json?

  turns            MockTurn[]
  dimensionScores  DimensionScore[]
  verdict          PanelVerdict?
  drills           DrillAssignment[]  @relation("SourceSession")
  confidencePoints ConfidenceMetric[]
  job              JudgmentJob?
  reservation      SpendReservation?
  outcome          Outcome?
  createdAt        DateTime           @default(now())

  @@unique([userId, clientRequestId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([scenarioId])
}

model MockTurn {
  id                   String           @id @default(cuid())
  sessionId            String
  session              MockSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seatId               String?
  role                 PracticeTurnRole
  seq                  Int
  // Client-generated id stable BEFORE seq is assigned at dequeue; the parallel
  // best-effort fluency audio upload joins on it to attach delivery metrics to
  // the right USER turn (the realtime transcript path has no word timings).
  clientTurnId         String?
  transcript           String?          @db.Text
  metricsJson          Json?
  // Verbatim disfluency report (fillers/repeats/false-starts/pauses) from the
  // Deepgram path; null when only the cleaning Whisper fallback ran. A1.
  disfluencyJson       Json?
  events               Json?
  transcriptionMissing Boolean          @default(false)
  audioStartMs         Int?
  audioEndMs           Int?
  createdAt            DateTime         @default(now())

  @@unique([sessionId, seq])
  // Unique (not just indexed): clientTurnId is the 1:1 join key for the parallel
  // fluency-audio upload, so the audio route can `update` one row, not updateMany.
  // NULLs are distinct in Postgres, so COACH turns (clientTurnId null) are fine. (A6)
  @@unique([sessionId, clientTurnId])
  @@index([sessionId, seq])
}

model DimensionScore {
  id          String         @id @default(cuid())
  sessionId   String
  session     MockSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  seatId      String?
  dimension   ScoreDimension @default(LP)
  key         String
  score       Int
  signalLevel SignalLevel
  evidence    String         @db.Text
  gap         String         @db.Text
  createdAt   DateTime       @default(now())

  @@index([sessionId, dimension])
  @@index([userId, key, createdAt(sort: Desc)])
}

model PanelVerdict {
  id            String      @id @default(cuid())
  sessionId     String      @unique
  session       MockSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  overallSignal SignalLevel
  inclination   String
  barRaiserVeto Boolean     @default(false)
  summary       String      @db.Text
  seatRollup    Json
  topStrengths  String[]
  topRisks      String[]
  // Provenance for calibration (D4). The exact rubric content + judge model that
  // produced THIS verdict, so (prediction → outcome) pairs partition by what made
  // them. Stamped explicitly by the orchestrator; the defaults only backfill rows
  // written before provenance existed (code constants are the source of truth).
  rubricVersion String      @default("2026.06.0")
  judgeModel    String      @default("gpt-4o-mini")
  createdAt     DateTime    @default(now())
}

model ConfidenceMetric {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId         String?
  session           MockSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  score             Int
  composure         Int
  resilience        Int?
  selfEfficacy      Int?
  difficultyApplied Int?
  measuredAt        DateTime     @default(now())

  @@index([userId, measuredAt(sort: Desc)])
}

model DrillAssignment {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceSessionId String?
  sourceSession   MockSession? @relation("SourceSession", fields: [sourceSessionId], references: [id], onDelete: SetNull)
  questionId      String
  targetLP        String
  reason          String       @db.Text
  status          DrillStatus  @default(ASSIGNED)
  resultSessionId String?
  assignedAt      DateTime     @default(now())
  completedAt     DateTime?

  @@unique([userId, questionId, sourceSessionId])
  @@index([userId, status])
}

model JudgmentJob {
  sessionId  String      @id
  session    MockSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status     JobStatus   @default(PENDING)
  attempts   Int         @default(0)
  leaseUntil DateTime?
  lastError  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status, leaseUntil])
}

// One real-interview outcome per mock session. predicted* are snapshotted at
// capture time so the labeled pair survives rubric/model churn (A1; the
// keystone the confidence calibration and the whole moat read from).
model Outcome {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String      @unique
  session   MockSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  result     InterviewOutcome @default(PENDING)
  offerLevel SignalLevel? // only meaningful when result = OFFER
  note       String?          @db.Text

  // Snapshot of what the panel predicted for this session, taken at capture time.
  predictedSignal  SignalLevel?
  predictedWeakest String? // the weakest DimensionScore.key at capture time
  rubricVersion    String? // forward-compat; populated once verdicts are version-pinned (Inc 2)

  capturedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, capturedAt(sort: Desc)])
  @@index([result])
}

// BYOK custody (INTERVIEW_ENGINE_PLAN D1/§3.3). Whose long-lived key decrypts
// into mintRealtimeEphemeral is the ONLY thing BYOK changes — the user's key
// pays for the commodity realtime minutes; Aloud's pinned key pays for judgment.
enum KeySource {
  ALOUD // house key (trial / no key on file)
  USER // the user's own ProviderKey
}

enum KeyStatus {
  ACTIVE
  INVALID // 401 at validate/mint — never auto-retry
  EXHAUSTED // 429 insufficient_quota
  REVOKED
}

// A user's provider API key, encrypted at rest (AES-256-GCM under the env KEK).
// The raw key transits the server exactly ONCE (POST /api/keys); thereafter only
// ciphertext exists and it is decrypted ONLY inside the mint call frame. No
// read-back endpoint exists; revoke = hard delete. One key per provider.
model ProviderKey {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        LlmProvider @default(OPENAI)
  ciphertextB64   String // AES-256-GCM ciphertext
  ivB64           String
  tagB64          String
  dekVersion      Int         @default(1) // 1 = env KEK; >=2 = KMS envelope (P2)
  last4           String // display ONLY (e.g. "…a1b2")
  fingerprint     String // sha256(key) prefix — dedupe/audit, never the key
  label           String?
  status          KeyStatus   @default(ACTIVE)
  capabilities    Json? // mint dry-run probe result { realtime, ttlSec, checkedAt }
  lastValidatedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  mockSessions MockSession[]

  @@unique([userId, provider]) // one key per provider; rotation = overwrite
  @@index([userId])
}

// The candidate's resume, parsed once before the interview. factsJson is the
// extraction output AFTER the anti-hallucination filter (each fact's verbatim
// quote validated as a substring of sourceText) — only validated facts are kept,
// and only those reach the interviewer instructions. sourceText is retained so
// the digest can be re-validated/re-extracted on a prompt change. One per user;
// re-upload overwrites. INTERVIEW_ENGINE_PLAN §14.1.
model ResumeProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  factsJson   Json
  sourceText  String   @db.Text
  rawS3Key    String?
  extractedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RateBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
}

model GlobalSpend {
  day    DateTime @id
  estUsd Decimal  @default(0)
}

model SpendReservation {
  sessionId   String      @id
  session     MockSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reservedUsd Decimal
  settledUsd  Decimal?
  createdAt   DateTime    @default(now())
}
