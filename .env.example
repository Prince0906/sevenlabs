# Copy to .env and fill in. Validated by src/lib/env.ts.
# (Set SKIP_ENV_VALIDATION=true to boot the UI without real values.)

# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/aloud"
# Migrate-only (prisma migrate dev / migrate diff via prisma.config.ts):
# never set at runtime or in prod. CI provides its own throwaway instance.
# SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/aloud_shadow"

# ── OpenAI ────────────────────────────────────────────────────
# House key: Bar-Raiser panel (Realtime mint), judge, Whisper fallback,
# resume extraction.
OPENAI_API_KEY="sk-..."
# Realtime is GA — use a GA model id (gpt-realtime / gpt-realtime-2),
# NOT a *-preview id. Endpoints default to the GA routes below.
# OPENAI_REALTIME_MODEL="gpt-realtime"
# OPENAI_REALTIME_MINT_URL="https://api.openai.com/v1/realtime/client_secrets"
# OPENAI_REALTIME_URL="https://api.openai.com/v1/realtime/calls"

# ── Deepgram (optional) ───────────────────────────────────────
# VERBATIM transcription for disfluency measurement (filler_words). When unset,
# the per-answer fluency path falls back to Whisper (which cleans speech, so
# fillers/repeats read low). Free tier at https://console.deepgram.com/signup
# DEEPGRAM_API_KEY="..."

# ── Spend caps (defaults shown) ───────────────────────────────
# REALTIME_USD_PER_MIN="0.3"
# SESSION_CEILING_USD="4"
# MAX_SESSION_SEC="3600"
# DAILY_CAP_USD="50"

# ── BYOK key encryption (optional) ────────────────────────────
# KEK for AES-256-GCM encryption of user-pasted OpenAI keys (ProviderKey).
# Unset ⇒ BYOK is disabled (/api/keys returns 503) and everything runs on
# the house key. Must be ≥ 32 chars. Rotating it invalidates all stored
# keys (users re-paste). Generate: openssl rand -base64 48
# KEY_ENCRYPTION_SECRET="..."

# ── Auth.js (NextAuth v5) ─────────────────────────────────────
AUTH_SECRET="run: openssl rand -base64 32"
# AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."
